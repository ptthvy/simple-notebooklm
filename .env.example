# Copy thành .env rồi điền. Mọi biến RAG_* đều ghi đè được cấu hình mặc định trong src/config.py.

# --- LLM: gemini (mặc định) | vllm | hf_local ---
RAG_LLM_PROVIDER=gemini
GOOGLE_API_KEY=
RAG_GEMINI_MODEL=gemini-3.6-flash

# --- Embedding (tải từ HuggingFace lần đầu) ---
RAG_EMBEDDING_MODEL=GreenNode/GreenNode-Embedding-Large-VN-Mixed-V1
# -1 = CPU, 0 = GPU đầu tiên
RAG_HF_DEVICE=-1

# --- Chunking / retrieval ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- Reranking ---
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_INITIAL_K=15
RAG_RERANK_TOP_K=5

# --- (tuỳ chọn) Qdrant server thay vì chế độ local, để chạy API + script đánh giá cùng lúc ---
# RAG_QDRANT_URL=http://localhost:6333

# --- (tuỳ chọn) vLLM / model local ---
# RAG_VLLM_API_BASE=http://localhost:8001/v1
# RAG_HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
